# Bot token from @BotFather
BOT_TOKEN=123456:ABC...

# Your Telegram user id: only your commands are executed and only you can open the panel
OWNER_ID=123456789

# Optional: business connection id. The bot learns it from updates and stores it in the DB;
# this value is only a fallback.
BUSINESS_CONNECTION_ID=

# Optional settings (defaults shown)
# Disk space for the cache in MB (media files + database). When it is exceeded,
# the oldest media files are removed first, then the oldest messages.
CACHE_LIMIT_MB=10240

# MAX_MEDIA_MB=20          # the Bot API cannot download files larger than 20 MB
# ANIMATION_MAX_FRAMES=40
# LOG_LEVEL=INFO
# Your time zone: `.time` without a city uses it, and the panel shows times in it.
# Changing it in the panel (Settings → Time zone) overrides this value.
TIMEZONE=Europe/Kyiv
